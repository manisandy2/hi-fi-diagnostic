# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
cd ~/hi-fi-diagnostic

cat > .gitignore <<'EOF'
# Dependencies
node_modules/

# Production build
dist/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.bak

# Test and coverage output
coverage/
playwright-report/
test-results/

# Local Docker overrides
docker-compose.override.yaml
compose.override.yaml
EOF
