
import { useEffect, useRef, useState } from "react";
import "./scroll-video.css";

const VIDEO_SRC = "/videos/hi-fi-diagnostic-scroll.mp4";

const STAGES = [
  { progress: 0.00, title: "Patient Preparation", subtitle: "A comfortable beginning to your diagnostic journey." },
  { progress: 0.12, title: "Medical Preparation", subtitle: "Professional care and preparation." },
  { progress: 0.25, title: "Blood Collection", subtitle: "A careful and controlled collection process." },
  { progress: 0.40, title: "Blood Sample Collection", subtitle: "Your sample is collected securely." },
  { progress: 0.53, title: "Sample Tube Filling", subtitle: "The sample is transferred into the collection tube." },
  { progress: 0.66, title: "Sample Storage", subtitle: "Secure handling of your blood sample." },
  { progress: 0.78, title: "Laboratory Testing", subtitle: "Advanced diagnostic analysis." },
  { progress: 0.89, title: "Report Generation", subtitle: "Your diagnostic results are prepared." },
  { progress: 0.97, title: "Report Delivery", subtitle: "Your health report, delivered with care." },
];

export default function ScrollVideoExperience() {
  const sectionRef = useRef(null);
  const videoRef = useRef(null);
  const rafRef = useRef(null);
  const targetTimeRef = useRef(0);

  const [progress, setProgress] = useState(0);
  const [duration, setDuration] = useState(0);
  const [videoReady, setVideoReady] = useState(false);
  const [videoError, setVideoError] = useState(false);

  const activeStage = STAGES.reduce(
    (active, stage) => progress >= stage.progress ? stage : active,
    STAGES[0]
  );

  useEffect(() => {
    const section = sectionRef.current;
    const video = videoRef.current;

    if (!section || !video) return;

    let disposed = false;

    video.pause();

    // Start a seek only when the previous seek has finished.
    const seekToLatestTarget = () => {
      if (disposed || video.seeking || video.readyState < 2) return;

      const target = targetTimeRef.current;

      if (Math.abs(video.currentTime - target) > 0.04) {
        video.currentTime = target;
      }
    };

    const updateFromScroll = () => {
      rafRef.current = null;

      if (disposed) return;

      const rect = section.getBoundingClientRect();
      const scrollDistance = section.offsetHeight - window.innerHeight;

      if (scrollDistance <= 0) return;

      const travelled = Math.max(
        0,
        Math.min(scrollDistance, -rect.top)
      );

      const nextProgress = travelled / scrollDistance;

      setProgress(nextProgress);

      if (
        Number.isFinite(video.duration) &&
        video.duration > 0
      ) {
        targetTimeRef.current =
          nextProgress * Math.max(0, video.duration - 0.05);

        seekToLatestTarget();
      }

      if (!video.paused) video.pause();
    };

    const requestScrollUpdate = () => {
      if (rafRef.current !== null) return;

      rafRef.current = requestAnimationFrame(updateFromScroll);
    };

    const handleMetadata = () => {
      if (disposed) return;

      setDuration(video.duration || 0);
      setVideoReady(true);
      requestScrollUpdate();
    };

    const handleSeeked = () => {
      // Catch up to the newest scroll position after each seek.
      seekToLatestTarget();
    };

    const handleError = () => {
      if (!disposed) {
        setVideoError(true);
        console.error("Scroll video failed to load:", video.error);
      }
    };

    video.addEventListener("loadedmetadata", handleMetadata);
    video.addEventListener("loadeddata", requestScrollUpdate);
    video.addEventListener("seeked", handleSeeked);
    video.addEventListener("error", handleError);

    window.addEventListener("scroll", requestScrollUpdate, {
      passive: true,
    });
    window.addEventListener("resize", requestScrollUpdate);

    if (video.readyState >= 1) {
      handleMetadata();
    }

    requestScrollUpdate();

    return () => {
      disposed = true;

      video.removeEventListener("loadedmetadata", handleMetadata);
      video.removeEventListener("loadeddata", requestScrollUpdate);
      video.removeEventListener("seeked", handleSeeked);
      video.removeEventListener("error", handleError);

      window.removeEventListener("scroll", requestScrollUpdate);
      window.removeEventListener("resize", requestScrollUpdate);

      if (rafRef.current !== null) {
        cancelAnimationFrame(rafRef.current);
      }
    };
  }, []);

  return (
    <section
      ref={sectionRef}
      className="scroll-video-track"
      aria-label="Hi-Fi Diagnostic patient journey"
    >
      <div className="scroll-video-sticky">
        <video
          ref={videoRef}
          className="scroll-video-element"
          src={VIDEO_SRC}
          muted
          playsInline
          preload="auto"
          disablePictureInPicture
          aria-label="Blood collection and laboratory testing journey"
        />

        <div className="scroll-video-overlay" />

        <header className="scroll-video-header">
          <span className="scroll-video-brand">HI-FI DIAGNOSTIC</span>
          <span className="scroll-video-tag">YOUR HEALTH. OUR PRIORITY.</span>
        </header>

        <div className="scroll-video-content">
          {!videoReady && !videoError && (
            <p className="scroll-video-loading">
              Loading medical experience...
            </p>
          )}

          {videoError && (
            <p className="scroll-video-loading">
              Unable to load video. Please check the video file.
            </p>
          )}

          <div className="scroll-video-caption">
            <span className="scroll-video-step">
              PATIENT JOURNEY /{" "}
              {String(STAGES.indexOf(activeStage) + 1).padStart(2, "0")}
            </span>
            <h2>{activeStage.title}</h2>
            <p>{activeStage.subtitle}</p>
          </div>
        </div>

        <footer className="scroll-video-footer">
          <div className="scroll-video-progress">
            <div
              className="scroll-video-progress-fill"
              style={{ width: `${progress * 100}%` }}
            />
          </div>

          <div className="scroll-video-footer-info">
            <span>SCROLL TO EXPLORE</span>
            <span>{Math.round(progress * 100)}%</span>
          </div>
        </footer>

        <div className="scroll-video-scroll-hint">
          <span>SCROLL DOWN</span>
          <span className="scroll-video-arrow">↓</span>
        </div>
      </div>

      <span className="sr-only">
        Video duration: {Math.round(duration)} seconds. Scroll to control playback.
      </span>
    </section>
  );
}
